# Template. Copy to .env and fill in -- .env is gitignored, this file is not.
# Never put real values in THIS file.

# Account identifier, format ORGNAME-ACCOUNTNAME.
# Snowsight -> bottom-left account menu -> hover account -> "Copy account identifier"
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=

# Auth: prefer key-pair. New Snowflake accounts block single-factor password
# sign-in for programmatic connections, so PASSWORD may simply not work.
# Set ONE of the following.
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_PASSWORD=

SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=EFA_WH
SNOWFLAKE_DATABASE=EFA
SNOWFLAKE_SCHEMA=RAW

# Local path holding 2019-Oct.csv and 2019-Nov.csv
DATA_DIR=./data

# Kaggle. USERNAME is your profile handle (kaggle.com/<username>), not your
# email. KEY is the token string from kaggle.com/settings -> Create New Token.
KAGGLE_USERNAME=
KAGGLE_KEY=
